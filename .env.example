# Backend (copy to backend/.env or set on Render)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ALLOWED_ORIGINS=*
PORT=8000

# Optional Supabase (demo works without these)
SUPABASE_URL=
SUPABASE_KEY=

# Frontend (copy to frontend/.env or set on Vercel)
VITE_API_URL=http://127.0.0.1:8010
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
